++            tab_offset += tab->Width + (tab_n < section->TabCount - 1 ? (g.Style.ItemInnerSpacing.x - g.Style.TabOverlap) : 0.0f);
+         }
+         tab_bar->WidthAllTabs += ImMax(section->Width + section->Spacing, 0.0f);
