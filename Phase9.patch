+@@ -10766,6 +10793,14 @@
+ 
+     // Render tab shape
+     const bool is_visible = (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_Visible) && !(flags & ImGuiTabItemFlags_Invisible);
++
++    // [SLATE PATCH B] The selected tab, and a hovered one, record into the upper z channel so their slanted
++    //   edges sit over their neighbours' -- the sheet's z-index 100 for .active and 80 for :hover. Everything
++    //   else stays in the lower channel and keeps its submission order.
++    const bool slate_raise = tab_bar->SlateZSplit && (tab_contents_visible || hovered || held);
++    if (slate_raise)
++        tab_bar->SlateZSplitter.SetCurrentChannel(window->DrawList, 1);
++
