-        col += Star.ColPad.rgb * (Star.DirLum.w * PostStar.w * Core * 5.73 * Flux);
+        col += Star.ColPad.rgb * (Star.DirLum.w * PostStar.w * Core * Flux);   // 5.73 is folded into Peak
     }
