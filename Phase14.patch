-Deliver<bool> ControlPanel::Construct(InteractionIndex&              ArrivingLedger,
-                                      RecordingSurface&              ArrivingSurface,
-                                      const AppearanceSpecification& ArrivingAppearance)
-{
-    if (Ledger != nullptr)
-    {
-        return Deliver<bool>::Refuse(Refusal{ RefusalReason::ContentUnsupported,
-                                              "ControlPanel is already constructed" });
-    }
-
-    Ledger     = &ArrivingLedger;
-    Surface    = &ArrivingSurface;
-    Appearance = &ArrivingAppearance;
-
-    return Deliver<bool>::Deliver(true);
-}
-
-void ControlPanel::Advance(const PointerCondition& Arriving, double Elapsed)
-{
-    if (Ledger == nullptr)
-        return;
-
-    Arrived       = Arriving;
-    DeferredCount = 0u;
-    Standing      = RedrawMark::Quiet;
-
-    Ledger->Advance(Arriving, Elapsed);
-
-    ContactHeldByPanel = Arriving.ContactHeld && ContactHeldByPanel;
-}
-
-void ControlPanel::FoldMark(RedrawMark Arriving)
-{
-    Standing = Dearer(Standing, Arriving);
-}
-
-bool ControlPanel::ContactTaken() const
-{
-    return ContactHeldByPanel;
-}
-
-RedrawMark ControlPanel::StandingMark() const
-{
-    return Standing;
-}
-
-void ControlPanel::Reset()
-{
-    Ledger             = nullptr;
-    Surface            = nullptr;
-    Appearance         = nullptr;
-    Arrived            = {};
-    DeferredCount      = 0u;
-    Standing           = RedrawMark::Quiet;
-    ContactHeldByPanel = false;
