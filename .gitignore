# Disposable agent output — never committed (see CLAUDE.md § Scratch folder).
_AgentScratch/

# Build output
build/
Build/Output/
*.obj
*.o
*.pdb
*.exe

# Editor/OS noise
.DS_Store
Thumbs.db

# Python bytecode caches
__pycache__/
*.pyc

# Engine dependencies: fetched by Frontier/Tools/Bootstrap.py, never committed
# Dependencies are fetched by Frontier/Tools/Bootstrap.py, never committed — but the lock file and README
#    ARE the manifest and must be tracked, exactly as the engine's own .gitignore does it.
Frontier/ExternalPackages/*
!Frontier/ExternalPackages/Dependencies.lock.json
!Frontier/ExternalPackages/README.md
Frontier/.cache/
Frontier/build/
image-search/

# Reconstructed by the project-owned Drive content author.
Frontier/Projects/Project-Drive/Content/Scenes/DriveCourse.r4.gltf
